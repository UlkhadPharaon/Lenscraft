# ============================================================================
# LensCraft AI — Environment variables
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# ============================================================================

# --- AI provider ------------------------------------------------------------
# AI_PROVIDER selects the backend:
#   gemini      -> Google Gemini  (needs GEMINI_API_KEY)
#   openrouter  -> OpenRouter API (needs OPENROUTER_API_KEY)
AI_PROVIDER=gemini

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override for the Gemini path.
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (OpenAI-compatible) — https://openrouter.ai/keys
# Keys look like sk-or-v1-... Use a multimodal model that accepts AUDIO input and
# structured outputs, e.g. qwen/qwen3.8-omni-flash (drop-in for Gemini).
# NOTE: qwen/qwen3.7-flash is text/image/video only (no audio) — not a substitute.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-omni-flash

# --- PocketBase (auth + cloud storage) --------------------------------------
# Self-hosted instance URL. Frontend (browser) + server use the same URL:
# https://lenscraft.185-7-81-99.sslip.io on the Ulkhad VPS.
VITE_POCKETBASE_URL=

# Superuser credentials of that instance (dashboard login). SERVER ONLY:
# PocketBase has no service-role key — the superuser token is what bypasses
# collection rules (quota enforcement, Stripe webhooks). Never expose to the
# browser, never prefix with VITE_.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Stripe (billing, Franc CFA) --------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional fixed price IDs (otherwise inline prices are created on the fly).
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Zero-decimal currency for plans: XOF = Franc CFA (XAF also works).
STRIPE_CURRENCY=xof

# --- App --------------------------------------------------------------------
# Public base URL used for Stripe redirects and CORS.
# Set this to your Cloudflare Pages URL after deployment (e.g.
# https://lenscraft-ai.<team>.pages.dev).
APP_URL=http://localhost:3000

# Server port (defaults to 3000)
PORT=3000
