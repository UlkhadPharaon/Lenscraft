{
  "name": "lenscraft-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/smoke.test.mjs",
    "test:smoke": "npm run test",
    "test:e2e": "npm run build && node tests/e2e.test.mjs",
    "test:export": "npm run build && node tests/export.test.mjs",
    "test:local": "npm run build && node tests/local-mode.test.mjs",
    "test:commercial": "npm run build && node tests/commercial.test.mjs",
    "test:survey": "npm run build && node tests/survey.test.mjs",
    "test:byok": "npm run build && node tests/byok.test.mjs",
    "test:all": "npm run test:e2e && npm run test:export && npm run test:local && npm run test:commercial && npm run test:survey && npm run test:byok && npm run test",
    "preview:workers": "vite build && wrangler dev",
    "deploy:workers": "vite build && wrangler deploy",
    "tail:workers": "wrangler tail"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pocketbase": "^0.28.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.15.1",
    "stripe": "^23.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "iconv-lite": "^0.7.3"
  }
}
